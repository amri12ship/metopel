{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "api"
      }
    }
  ],
  "crons": [
    {
      "path": "/",
      "schedule": "0 8 * * *"
    }
  ]
}